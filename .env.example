API_PORT=4010
WEB_PORT=8088
DATABASE_URL=postgresql://ued:ued_demo@postgres:5432/ued_demo
REDIS_URL=redis://redis:6379
DEMO_LOCAL_ONLY=true
ROVER_PRODUCT_NAME=Wall-E Sentinel
INVESTOR_HTML_URL=/investor/

# Private portal and NDA access. Generate unique values; never commit the real .env.
PUBLIC_BASE_URL=http://127.0.0.1:8088
EXTERNAL_PORTAL_ENABLED=false
EMAIL_VERIFICATION_PROVIDER=NONE
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=scrypt:HEX_SALT:HEX_SCRYPT_HASH
ADMIN_TOTP_SECRET=
ADMIN_MFA_REQUIRED=false
ADMIN_SESSION_IDLE_MINUTES=30
ADMIN_SESSION_MAX_HOURS=8
SESSION_SECRET=AT_LEAST_32_RANDOM_CHARACTERS
INVITATION_TOKEN_HMAC_SECRET=DIFFERENT_AT_LEAST_32_RANDOM_CHARACTERS
IP_FINGERPRINT_SECRET=ANOTHER_DIFFERENT_AT_LEAST_32_RANDOM_CHARACTERS
IP_ENCRYPTION_KEY=64_HEX_CHARACTERS
IP_ENCRYPTION_KEY_VERSION=1
DEFAULT_INVITE_TOKEN=LONG_RANDOM_URL_SAFE_TOKEN
VISITOR_SESSION_IDLE_MINUTES=120
VISITOR_SESSION_MAX_HOURS=72
COOKIE_SECURE=false

# The bundled document is a workflow draft. Set APPROVED only after counsel replaces it.
NDA_LEGAL_STATUS=DRAFT_FOR_WORKFLOW_TESTING
PRIVACY_LEGAL_STATUS=DRAFT
NDA_RETENTION_NOTICE=Retention period pending legal approval.
PRIVACY_CONTACT_EMAIL=privacy@example.com

# SMTP. Local Compose uses Mailpit; production must use an approved transactional provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=UP-EYE-DAWN <nda@up-eye-dawn.local>
SMTP_ARCHIVE=
NDA_ARCHIVE_EMAIL=

# Retention values are operational placeholders until counsel approves policy.
VISITOR_SESSION_RETENTION_DAYS=30
AUDIT_EVENT_RETENTION_DAYS=365
NDA_EVIDENCE_RETENTION_DAYS=2555
ENCRYPTED_IP_RETENTION_DAYS=90
