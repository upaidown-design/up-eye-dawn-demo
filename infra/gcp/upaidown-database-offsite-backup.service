[Unit]
Description=UP AI DOWN encrypted database backup and isolated restore drill
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/upaidown-database-offsite-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/upaidown-database-offsite-backup /root/.config/gcloud /root/.cache/gcloud /var/run/docker.sock
ProtectHome=read-only
NoNewPrivileges=true
