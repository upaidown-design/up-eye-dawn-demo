[Unit]
Description=UP AI DOWN encrypted off-site mail backup and restore drill
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/upaidown-mail-offsite-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/upaidown-mail-offsite-backup /root/.config/gcloud /root/.cache/gcloud
ProtectHome=read-only
NoNewPrivileges=true
